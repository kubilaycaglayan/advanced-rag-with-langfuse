LANGFUSE_BASE_URL=http://127.0.0.1:28420
# Dashboard-managed Cloudflare Tunnel connector; set only in untracked .env.
CLOUDFLARE_PRODUCTION_TUNNEL_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
EXPERIMENT_TRIGGER_TOKEN=
LANGFUSE_WEBHOOK_SECRET=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=-1
# Set OLLAMA_CONTEXT_LENGTH=8192 on the host Ollama service to avoid reloads between
# pipeline calls (num_ctx 8192) and judge calls (default context).
QDRANT_URL=http://127.0.0.1:6333
CORPUS_DIR=./corpus
GENERATION_MODEL=qwen3:8b
EVALUATOR_MODEL=qwen3:8b
# Langfuse project connection name used by managed LLM-as-a-Judge evaluators.
LANGFUSE_EVALUATOR_PROVIDER=ollama-local
LANGFUSE_OLLAMA_PROXY_TOKEN=
# Optional separate Ollama endpoint for evaluation; defaults to OLLAMA_URL.
EVALUATOR_OLLAMA_URL=
# Local `opencode serve` endpoint for answer_correctness_v3; start it in an empty directory.
OPENCODE_JUDGE_URL=http://127.0.0.1:4096
EMBEDDING_MODEL=sentence-transformers/multi-qa-MiniLM-L6-cos-v1
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
PASSAGE_CHARS=1200
# Join consecutive paragraphs until a passage reaches this length (0 disables).
MIN_PASSAGE_CHARS=400
EXPERIMENT_DATA_DIR=./data
DATASET_NAME=QA.csv
LANGFUSE_PROMPT_LABEL=production
